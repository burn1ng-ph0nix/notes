"""ACTIONS ON OBJECTIVE"""

  Initial Access:
    whoami
    id
    uname -a
    hostname
    pwd
    ls -la
    cat /etc/passwd
    cat /etc/shadow
  
  Priv Esc:
    sudo -l
    find / -perm -4000 -type f 2>/dev/null
    cat /etc/sudoers
    
    Artifacts left behind: 
      Shell History 
      Audit Logs  
      Bash Process Traces 
      File Access Timestamps 


  Log Clearing:
    history -c                           # clear current session history 
    rm ~/.bash_history                   # Delete history file
    truncate -s 0 /var/log/auth.log      # Truncate log file to zero bytes
    echo "" > ~/.bash_history            # Overwrite history file
    rm /var/log/auth.log                 # Log File Deletion
    rm /var/log/syslog                   # "                "
    rm /var/log/messages                 # "                "
    systemctl stop rsyslog               # Stop logging services
    systemctl stop auditd                # "                  "
    systemctl restart rsyslog            # Restart services
    journalctl --vacuum-time=1s          # Vacuum journal logs
    rm -rf /var/log/journal/*            # Remove journal directory
    auditctl -e 0










